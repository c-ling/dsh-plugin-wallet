    "pricing",
    "cost",
    "usage",
    "sidebar",
    "web-ui",
    "badge",
    "open-source",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-ling/dsh-plugin-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/c-ling/dsh-plugin-wallet/issues"
  },
